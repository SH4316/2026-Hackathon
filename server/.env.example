# 비밀값 없는 예시. 복사해서 .env 로 사용하고 .env 는 커밋하지 않는다.

# 쉼표로 구분한 API 키 목록. 실제 값은 직접 생성: python -c "import secrets;print(secrets.token_urlsafe(32))"
PG_API_KEYS=
# 로컬 개발 전용. 운영에서는 false.
PG_AUTH_DISABLED=false

PG_POLICY_PATH=policies/default.yaml
PG_MAX_TEXT_CHARS=50000
PG_MAX_BODY_BYTES=262144

# 대시보드용 관리 키(규칙·문맥 탐지기·프롬프트 편집). 비우면 관리 API 를 쓸 수 없다.
PG_ADMIN_KEYS=

# 실행할 compose 파일. 지정하면 -f 없이 `docker compose up -d` 로 실행된다.
#   compose.local.yaml: API + 4B 판단 모델(decider) / compose.api.yaml: API 만(모델은 아래 PG_MODEL_* 설정)
# COMPOSE_FILE=compose.local.yaml

# ── compose.local.yaml 전용 ──
# Ollama 모델 태그. 처음 실행할 때 decider-pull 이 model-data 볼륨에 내려받는다.
DECIDER_MODEL=qwen3:4b-instruct-2507-q4_K_M
# true 면 내려받지 않는다(폐쇄망: 모델을 볼륨에 미리 반입).
DECIDER_OFFLINE=false

# disabled | optional | required
# compose.api.yaml 은 이 값을 그대로 쓰고(기본 disabled = 규칙만),
# compose.local.yaml 은 비어 있으면 optional 로 실행하며 아래 PG_MODEL_API·BASE_URL·NAME 을 무시한다.
PG_MODEL_MODE=disabled
# ── compose.api.yaml·로컬 개발에서 쓰는 모델 서버 ──
# ollama | openai(llama.cpp server·vLLM 등 OpenAI 호환 로컬 서버). 원문이 전송되므로 조직 내부 주소만.
PG_MODEL_API=ollama
# 컨테이너 안에서 접근하는 주소(127.0.0.1 은 api 컨테이너 자신). 예: 다른 장비의 decider, 조직 GPU 서버
PG_MODEL_BASE_URL=http://model-server.internal:11434
# OpenAI 호환 로컬 서버가 키를 요구할 때만
PG_MODEL_API_KEY=
PG_MODEL_NAME=
PG_MODEL_TIMEOUT_S=20
PG_MODEL_MAX_CONCURRENCY=2

PG_AUDIT_DB_PATH=data/audit.sqlite3
# 대시보드에서 연결한 개인 클라이언트(등록 코드·토큰 해시)
PG_CLIENTS_DB_PATH=data/clients.sqlite3
# 등록 코드 기본 유효 시간(분)
PG_ENROLLMENT_TTL_MINUTES=1440
# 대시보드 웹 화면 출처(쉼표 구분). 브라우저에서 관리 API 를 직접 부를 때만. 예: https://dashboard.example.org
PG_CORS_ORIGINS=
PG_RULESET_DB_PATH=data/ruleset.sqlite3

# 호스트 포트 바인딩(기본: 루프백만). 원격 공개 시 TLS 리버스 프록시 뒤에 둔다.
PG_BIND=127.0.0.1:8000

# ── 조직 관리(대시보드 연동) ──
# 대시보드 '감시 연동'에서 발급한 연결 URL(<대시보드 주소>/api/v1/connectors/<id>#<secret>). 설정하면 조직 서버로 동작한다:
#   대시보드 활성 설정의 태그 pythonRegex·Jev 프롬프트(jevThreshold)를 모든 검사에 적용하고,
#   대시보드 '검사 서버 설정'(원문 처리·태그 조치·태그 매핑·Jev)을 따르며,
#   대시보드 사람 ID 로 등록한 사용자의 전송 시점 검사를 /api/v1/detector-events 로 기록한다.
# 비우면 로컬(독립) 서버. 비밀값이 들어 있으므로 저장소에 커밋하지 않는다.
# Docker 안에서 같은 PC 의 대시보드라면 연결 URL 을 만들 때 주소를 http://host.docker.internal:8080 으로 지정한다.
PG_DASHBOARD_CONNECTION=
# (이전 방식) 연결 없이 대시보드 주소만. 대시보드에서 연결을 한 번이라도 발급하면 401 로 거부된다.
PG_DASHBOARD_URL=
PG_DASHBOARD_TIMEOUT_S=5
# 활성 설정을 다시 받는 간격(초)
PG_DASHBOARD_REFRESH_S=30
# 조직 설정의 서버 보관 위치(대시보드 설정을 받을 수 없을 때만 사용). 관리 API: /v1/admin/org/settings
PG_ORG_DB_PATH=data/org.sqlite3
