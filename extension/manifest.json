{
  "manifest_version": 3,
  "name": "Prompt Guard",
  "version": "0.3.0",
  "description": "프롬프트를 기기 내 AI와 선택한 검사 서버로 확인하고 민감정보 전송을 제어합니다.",
  "permissions": [
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://www.meta.ai/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "src/labels.js",
        "src/sites.js",
        "src/site-context.js",
        "src/entry-policy.js",
        "src/ui.js",
        "src/restore.js",
        "src/pdf.js",
        "src/office.js",
        "src/files.js",
        "src/local.js",
        "src/content.js",
        "src/entry-warning.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Guard"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/personal.js",
        "vendor/prompt-guard-rules/src/*.js",
        "vendor/prompt-guard-rules/data/*.js",
        "vendor/pdfjs/*.mjs",
        "vendor/pdfjs/cmaps/*"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://www.meta.ai/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "version_name": "0.3.0 (기기 내 AI 검사)",
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
