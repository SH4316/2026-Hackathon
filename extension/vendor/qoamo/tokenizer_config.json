{
  "backend": "tokenizers",
  "bos_token": "<s>",
  "clean_up_tokenization_spaces": true,
  "cls_token": "<cls>",
  "do_lower_case": false,
  "eos_token": "<\\s>",
  "mask_token": "<mask>",
  "model_max_length": 16384,
  "pad_token": "<pad>",
  "sep_token": "<sep>",
  "strip_accents": null,
  "tokenize_chinese_chars": true,
  "tokenizer_class": "BertTokenizer",
  "unk_token": "<unk>",
  "additional_special_tokens": [
    "[OPT]"
  ]
}