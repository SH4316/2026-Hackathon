# 저장소 루트에서 cp .env.example .env 후 값을 설정한다. .env 는 커밋하지 않는다.
# 루트 compose.yml 은 이 파일의 값을 서비스별로 나눠 전달한다.

# 로컬 실행용 예시 DB 비밀번호. MYSQL_ROOT_PASSWORD 는 필수다.
MYSQL_ROOT_PASSWORD=dashboard-root-local
DB_USERNAME=dashboard
DB_PASSWORD=dashboard-local

# 호스트 공개 주소·포트. 기본 0.0.0.0은 다른 호스트에서도 접근 가능하다.
# 대시보드는 인증 없이 관리 프록시를 제공한다. 로컬 시연은 두 *_BIND_IP를 127.0.0.1로 제한한다.
APP_BIND_IP=0.0.0.0
APP_PORT=8080
PG_BIND_IP=0.0.0.0
PG_PORT=8000

# 선택: 외부 Nginx + Cloudflare Tunnel 연결용.
# 현재 compose.yml 에는 nginx/cloudflared 서비스가 없으며 아래 변수도 자동 전달하지 않는다.
# NGINX_* 는 별도 Nginx 템플릿에, TUNNEL_TOKEN 은 cloudflared 환경변수로 전달한다.
# Nginx 공식 이미지의 /etc/nginx/templates/*.template 에서 아래 변수를 참조할 수 있다.
# 두 호스트를 각 server_name 에, NGINX_PORT 를 listen 에 사용한다.
NGINX_DASHBOARD_HOST=dashboard.example.com
NGINX_API_HOST=api.example.com
NGINX_PORT=80
# 호스트에서 Nginx 를 실행하면 APP_BIND_IP 와 PG_BIND_IP 를 127.0.0.1 로 변경한다.
# upstream: 대시보드 http://127.0.0.1:8080, 검사 API http://127.0.0.1:8000.
# APP_PORT/PG_PORT 를 바꾸면 upstream 포트도 맞춘다.
# 같은 Compose 네트워크의 Nginx 에서는 http://dashboard:8080, http://server:8000 을 쓴다.
# Cloudflare 에 두 공개 호스트를 등록하고 각각 Nginx 의 HTTP 주소로 연결한다.
# cloudflared 가 호스트에서 실행되면 http://127.0.0.1:80 (NGINX_PORT 와 일치시킨다).
# 별도 컨테이너에서 실행되면 해당 컨테이너에서 접근 가능한 Nginx 주소를 사용한다.
# 원격 관리형 터널의 토큰. Cloudflare API 토큰과 다르며 실제 값은 .env 에만 저장한다.
# TUNNEL_TOKEN 을 환경변수로 전달한 뒤 cloudflared tunnel --no-autoupdate run 으로 실행한다.
TUNNEL_TOKEN=

# 필수: 직접 생성한 API 키(여러 키는 쉼표로 구분).
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
PG_API_KEYS=
# 관리 API 용 별도 키. 관리 API 를 쓰려면 API 키와 다른 값을 생성한다.
PG_ADMIN_KEYS=
# 루트 compose는 URL을 http://server:8000으로 고정하고 PG_ADMIN_KEYS를 GUARD_ADMIN_KEY로 전달한다.
# 아래 GUARD_* 값은 루트 compose의 고정 매핑을 덮어쓰지 않는다. 백엔드는 첫 관리 키만 사용한다.
# 별도 dashboard 실행은 GUARD_SERVER_URL과 직접 생성한 PG_ADMIN_KEYS의 첫 키를 실행 환경에 주입한다.
# 키는 백엔드에만 두며 브라우저에는 전달하지 않는다. dashboard 전용 compose는 별도 전달 설정이 필요하다.
GUARD_SERVER_URL=http://server:8000
GUARD_ADMIN_KEY=
PG_AUTH_DISABLED=false

# 정책 파일과 SQLite 경로는 컨테이너 기준이다. DB 는 /srv/data 아래에 둔다.
PG_POLICY_PATH=/srv/policies/default.yaml
PG_MAX_TEXT_CHARS=50000
PG_MAX_BODY_BYTES=262144
PG_AUDIT_DB_PATH=/srv/data/audit.sqlite3
PG_CLIENTS_DB_PATH=/srv/data/clients.sqlite3
PG_RULESET_DB_PATH=/srv/data/ruleset.sqlite3
PG_ORG_DB_PATH=/srv/data/org.sqlite3
PG_ENROLLMENT_TTL_MINUTES=1440
# 브라우저에서 관리 API 를 직접 호출할 때만 대시보드 출처를 쉼표로 지정한다.
# 예: http://192.168.0.10:8080 또는 https://dashboard.example.com (경로·끝 슬래시 제외).
# NGINX_DASHBOARD_HOST 를 바꾸면 위 HTTPS 예시의 호스트도 맞춘다.
PG_CORS_ORIGINS=

# 실제 Decider-4B v3 Q4_K_M을 함께 실행한다. 모델 모드는 초기값이며 이후 대시보드 저장값이 우선한다.
# required는 모델 실패 시 오류, optional은 미완료, disabled는 모델 검사를 끈다.
# 별도 실행에서 모델 BASE_URL 또는 NAME 미설정은 경고 후 기능 비활성(그 사유만으로 회색 처리하지 않음).
PG_MODEL_MODE=required
# PG_MODEL_API=decider, BASE_URL=http://decider:8000, NAME=Mapika/decider-4b 는
# compose.yml 에서 고정한다. 모델 서비스는 호스트 포트를 공개하지 않는다.
PG_MODEL_TIMEOUT_S=120
PG_MODEL_MAX_CONCURRENCY=2

# 첫 실행 시 decider-pull 이 약 2.7 GB 모델을 받으며 이후 볼륨 캐시를 재사용한다.
# true 는 네트워크 다운로드를 금지한다. 먼저 같은 revision 의 캐시를 반입해야 한다.
DECIDER_OFFLINE=false
DECIDER_THREADS=4
# compose.gpu.yml 전용. -1 은 모든 레이어, 양수는 GPU 로 보낼 레이어 수다.
# 기본 CPU 구성은 항상 0 이며 이 값을 무시한다.
DECIDER_GPU_LAYERS=-1

# PG_DASHBOARD_URL 은 compose.yml 에서 http://dashboard:8080 으로 고정한다.
# 조직 기록은 검사 응답 전에 완료를 기다린다. report_status 실패·누락 시 확장은 전송을 보류한다.
# 원문 기록 기본값은 full이며 검사 서버 관리에서 masked·off와 policy_state_map 등을 저장한다.
# 대시보드 '검사 서버 연결'에서 연결 URL 을 만들 때 "검사 서버가 접속할 대시보드 주소"를 http://dashboard:8080 으로,
# "사용자가 확장에 넣을 검사 서버 주소"를 사용자 PC 에서 보이는 이 서버 주소로 넣고, 발급된 URL 을 여기에 넣는다.
# 연결을 한 번이라도 발급하면 대시보드는 연결 URL 없이 규칙 조회·기록을 거부한다. 비밀값이므로 커밋하지 않는다.
PG_DASHBOARD_CONNECTION=
PG_DASHBOARD_TIMEOUT_S=5
PG_DASHBOARD_REFRESH_S=30
