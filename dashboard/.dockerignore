# Send only the source and build manifests needed by the image build.
**
!Dockerfile
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
backend/**
!backend/build.gradle
!backend/settings.gradle
!backend/gradlew
!backend/gradle/
backend/gradle/**
!backend/gradle/wrapper/
backend/gradle/wrapper/**
!backend/gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.properties
!backend/src/
!backend/src/**

# Keep local credentials and generated files out, even inside source directories.
**/.git
**/.env
**/.env.*
**/.npmrc
**/gradle.properties
**/*.pem
**/*.key
**/.gradle
**/node_modules
**/build
**/dist
**/coverage
**/logs
**/*.log
**/validation
**/screenshots
