# Local demo credentials only. Copy this file to .env before starting Compose.
MYSQL_ROOT_PASSWORD=dashboard-root-local
DB_USERNAME=dashboard
DB_PASSWORD=dashboard-local

# Host binding for compose-dev.yml only. 0.0.0.0 allows access from other hosts.
# The default compose.yaml always publishes the app at 127.0.0.1:8080.
APP_BIND_IP=0.0.0.0
APP_PORT=8080

# Optional host-run Java app setting; export it in the app's shell when needed.
# Compose reads this file for interpolation, but fixes its backend DB_URL to
# jdbc:mysql://mysql:3306/... so a host loopback URL cannot break container access.
# The Java app does not read .env automatically.
DB_URL='jdbc:mysql://127.0.0.1:3306/ai_security_dashboard?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
