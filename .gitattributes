# 줄바꿈: 저장소에는 LF 로 저장한다.
* text=auto

# 리눅스 컨테이너·셸에서 실행하는 스크립트는 Windows(core.autocrlf=true)에서도 LF 로 체크아웃한다.
# (CRLF 로 바뀌면 Docker 빌드에서 "./gradlew: not found" 로 실패한다)
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.bcmap binary

# GitHub 언어 통계·PR diff 에서 접어 둘 복사본·자동 생성 파일
extension/vendor/** linguist-vendored
packages/prompt-guard-rules/data/policy.js linguist-generated
packages/prompt-guard-rules/test/golden-vectors.json linguist-generated
**/package-lock.json linguist-generated
dashboard/validation/** linguist-documentation
